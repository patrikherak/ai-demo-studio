# Copy to .env and fill in. Never commit .env.

# Narration
# Easiest: run `node scripts/configure-voice.mjs` once. It asks for the language, provider,
# model and voice, plays samples in that language and fills in the values below.
# Language of the voice-over, cards and chips (ISO 639-1: en, de, fr, it, es, pt, nl, sk, cs, pl,
# sv, ja, zh, ko, ar, …). Independent of the product's UI language (DEMO_LANGUAGE below).
NARRATION_LANGUAGE=en
# Optional accent / locale for voice choice and number formats: en-US, en-GB, de-CH, pt-BR, fr-CA, …
NARRATION_LOCALE=
# elevenlabs | openai | say (empty = the first one whose key is present)
NARRATION_PROVIDER=

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Default voice; configure-voice.mjs lists the voices that speak NARRATION_LANGUAGE (yours and the public library)
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 = most natural for long narration; eleven_turbo_v2_5 / eleven_flash_v2_5 = faster, cheaper
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Forces the language on models that support it (turbo/flash v2.5); set automatically from NARRATION_LANGUAGE
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=1.0

# Alternative endpoint (proxy, regional deployment, test server)
ELEVENLABS_API_BASE=

# OpenAI: narration (gpt-4o-mini-tts), word timing for any provider, synthetic seed photos
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Speaking style; the language instruction is added from NARRATION_LANGUAGE
OPENAI_TTS_INSTRUCTIONS=
OPENAI_API_BASE=
IMAGE_MODEL=gpt-image-1

# macOS offline voice (say -v '?'); empty = best installed voice for NARRATION_LANGUAGE
SAY_VOICE=

# Workspace
# Every job lives in $DEMO_WORKDIR/<project-slug>/ (source, plans, audio, raw takes, clips, final)
DEMO_WORKDIR=./work
# Playwright, Chromium and ffmpeg are installed here by scripts/setup-tools.sh
DEMO_TOOLS_DIR=./.tools
# Language of the product's UI and of the seed data (film the UI in the language it ships in)
DEMO_LANGUAGE=en
# Default recording size (CSS pixels) and pixel density
DEMO_VIEWPORT=1600x1000
DEMO_DEVICE_SCALE_FACTOR=2
# Canvas of stage and card scenes, and of the final video
DEMO_OUTPUT=1920x1080
# screencast (full quality over CDP) | video (Playwright's 1 Mbit/s recorder)
DEMO_CAPTURE=screencast
# Folder with whoosh/pop/click/chime.wav for scenes with "sfx": true (python3 scripts/music.py --sfx-dir DIR)
DEMO_SFX_DIR=

# Target project (optional; you can also just tell the agent a path or URL)
PROJECT_PATH=
PROJECT_REPO_URL=
PROJECT_REF=
# Token for cloning a private repository over https (read-only scope is enough)
GIT_TOKEN=

# Optional delivery to S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
DELIVERY_S3_BUCKET=
DELIVERY_S3_PREFIX=demos
# Leave empty for AWS; set for R2/MinIO/B2, e.g. https://<account>.r2.cloudflarestorage.com
DELIVERY_S3_ENDPOINT_URL=
DELIVERY_URL_TTL_SECONDS=604800
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
